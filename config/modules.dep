# qmjyOS module dependency graph
# Format: MODULE: DEPENDENCY1 DEPENDENCY2
# Empty dependency list means no direct dependency.

QBOOT:
QBOOT_BIOS: QBOOT ARCH_X86_64
QBOOT_UEFI: QBOOT

ARCH_X86_64:
ARCH_AARCH64:

KERNEL_CORE: ARCH_X86_64
KERNEL_SECURITY: KERNEL_CORE
KERNEL_MODULES: KERNEL_CORE

MM_PHYSICAL: ARCH_X86_64 KERNEL_CORE
MM_PAGING: ARCH_X86_64 KERNEL_CORE MM_PHYSICAL
MM_HEAP: KERNEL_CORE MM_PAGING
MM_SLAB: MM_HEAP
MM_VIRTUAL: MM_PAGING MM_PHYSICAL

PROCESS: KERNEL_CORE MM_VIRTUAL
THREAD: PROCESS
SCHEDULER: KERNEL_CORE MM_PHYSICAL
SCHEDULER_PREEMPTIVE: SCHEDULER THREAD

IPC: RUNTIME SYSCALL
SYSCALL: ARCH_X86_64 KERNEL_CORE

DRIVER_SERIAL: ARCH_X86_64 KERNEL_CORE
DRIVER_PCI: ARCH_X86_64 KERNEL_CORE
DRIVER_BLOCK: KERNEL_CORE MM_HEAP
DRIVER_STORAGE: DRIVER_BLOCK KERNEL_CORE
DRIVER_NETWORK: KERNEL_CORE MM_HEAP
DRIVER_DISPLAY: KERNEL_CORE MM_HEAP
DRIVER_GRAPHICS: DRIVER_DISPLAY
DRIVER_INPUT: KERNEL_CORE
DRIVER_USB: DRIVER_PCI KERNEL_CORE
DRIVER_AUDIO: KERNEL_CORE
DRIVER_BLUETOOTH: DRIVER_USB DRIVER_NETWORK

FS_VFS: KERNEL_CORE MM_HEAP
FS_RAMFS: FS_VFS MM_HEAP FS_QFS
FS_QFS: FS_VFS DRIVER_BLOCK
FS_DEVFS: FS_VFS
FS_PROCFS: FS_VFS PROCESS
FS_SYSFS: FS_VFS
FS_FAT: FS_VFS DRIVER_BLOCK
FS_BTRFS: FS_VFS STORAGE MM_HEAP
FS_EXT2: FS_VFS DRIVER_BLOCK

STORAGE: DRIVER_BLOCK KERNEL_CORE
NETWORK_STACK: DRIVER_NETWORK KERNEL_CORE

RUNTIME: SYSCALL
SERVICE_MANAGER: RUNTIME
SERVICE_REGISTRY: RUNTIME
SERVICE_LOGGING: RUNTIME
SERVICE_CONFIG: RUNTIME
INIT_MANAGER: RUNTIME SERVICE_MANAGER SERVICE_REGISTRY SERVICE_LOGGING SERVICE_CONFIG
CAPABILITY: RUNTIME

SYSTEM_SERVICES: RUNTIME SYSCALL IPC SERVICE_MANAGER SERVICE_REGISTRY SERVICE_LOGGING SERVICE_CONFIG INIT_MANAGER CAPABILITY
QSHELL: RUNTIME SYSCALL SYSTEM_SERVICES
DESKTOP: RUNTIME SYSTEM_SERVICES DRIVER_DISPLAY DRIVER_INPUT
APPLICATIONS: RUNTIME SYSCALL

QPACKAGE: FS_VFS NETWORK_STACK
QINSTALL: STORAGE FS_VFS QBOOT
QRECOVERY: STORAGE FS_VFS

QBUILD:
QDEBUG: QBUILD
QTEST: QBUILD
